{
  "name": "@car-cutter/next-webplayer",
  "version": "3.2.17",
  "license": "Apache-2.0",
  "author": {
    "name": "CarCutter",
    "url": "https://www.car-cutter.com/"
  },
  "description": "Use CarCutter WebPlayer in your Next app",
  "homepage": "https://carcutter.github.io/cars-webplayer-js/",
  "repository": {
    "type": "git",
    "url": "https://github.com/carcutter/cars-webplayer-js"
  },
  "keywords": [
    "car-cutter",
    "webplayer",
    "next"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js",
      "require": "./dist/legacy.cjs"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b --force && vite build",
    "pack:check": "pnpm pack --out package.tgz && publint package.tgz --level error && attw package.tgz --profile node16 --ignore-rules false-esm --format table-flipped",
    "lint": "eslint . --max-warnings 0",
    "analyze": "vite-bundle-visualizer",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@car-cutter/react-webplayer": "workspace:^"
  },
  "peerDependencies": {
    "@types/react": "*",
    "next": ">=10",
    "react": ">=16.8",
    "react-dom": ">=16.8"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@car-cutter/core": "workspace:^",
    "@car-cutter/typescript-config": "workspace:^",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^22",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "browserslist": "^4.29.5",
    "browserslist-to-esbuild": "^2.1.1",
    "happy-dom": "^21.0.4",
    "next": "16.4.5",
    "react": ">=18",
    "react-dom": ">=18",
    "rollup-preserve-directives": "^1.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  },
  "browserslist": [
    "defaults"
  ]
}
