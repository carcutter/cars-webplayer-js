{
  // Declarations build: the private workspace packages resolve to their built
  // declarations (dist/types), which are rolled up into this package's .d.ts.
  // vite.config.ts adds vue, to the lowest supported version (peer ^3.3)
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@car-cutter/core": ["../core/dist/types/index"],
      "@car-cutter/core-wc": ["../core-wc/dist/types/index"],
      "@car-cutter/analytics": ["../analytics/dist/types/src/index"]
    }
  },
  // Generates the declarations for that lowest version: aimed at the
  // installed one, they would use features 3.3 lacks (it dropped the emits)
  "vueCompilerOptions": { "target": 3.3 }
}
