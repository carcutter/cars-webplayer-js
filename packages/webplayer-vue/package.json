{
  "name": "@car-cutter/vue-webplayer",
  "version": "3.2.17",
  "license": "Apache-2.0",
  "author": {
    "name": "CarCutter",
    "url": "https://www.car-cutter.com/"
  },
  "homepage": "https://carcutter.github.io/cars-webplayer-js/",
  "repository": {
    "type": "git",
    "url": "https://github.com/carcutter/cars-webplayer-js"
  },
  "description": "Use CarCutter WebPlayer in your Vue app",
  "keywords": [
    "car-cutter",
    "webplayer",
    "vue"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vue-tsc -b --force && vite build",
    "lint": "eslint . --ext ts --max-warnings 0",
    "analyze": "vite-bundle-visualizer",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@car-cutter/wc-webplayer": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.3"
  },
  "devDependencies": {
    "@car-cutter/analytics": "workspace:^",
    "@car-cutter/core": "workspace:^",
    "@car-cutter/typescript-config": "workspace:^",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "~2.5.1",
    "browserslist": "^4.29.5",
    "browserslist-to-esbuild": "^2.1.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5",
    "vite": "^6.4.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-dts": "^4.2.1",
    "vitest": "^5.1.0",
    "vue": "^3",
    "vue-3.3": "npm:vue@~3.3.13",
    "vue-tsc": "^2.1.6"
  },
  "browserslist": [
    "defaults"
  ]
}
