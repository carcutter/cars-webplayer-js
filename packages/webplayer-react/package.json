{
  "name": "@car-cutter/react-webplayer",
  "version": "3.2.17",
  "license": "Apache-2.0",
  "author": {
    "name": "CarCutter",
    "url": "https://www.car-cutter.com/"
  },
  "description": "Use CarCutter WebPlayer in your React app",
  "homepage": "https://carcutter.github.io/cars-webplayer-js/",
  "repository": {
    "type": "git",
    "url": "https://github.com/carcutter/cars-webplayer-js"
  },
  "keywords": [
    "car-cutter",
    "webplayer",
    "react"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js",
      "require": "./dist/legacy.cjs"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "analyze": "vite-bundle-visualizer",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@car-cutter/analytics": "*",
    "@car-cutter/core": "*",
    "@car-cutter/core-ui": "*",
    "@car-cutter/core-wc-react-16-17": "*",
    "@car-cutter/core-wc-react-18": "*",
    "@car-cutter/eslint-config": "*",
    "@car-cutter/typescript-config": "*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "browserslist": "^4.28.7",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint": "^8",
    "happy-dom": "^21.0.4",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-dts": "^4.2.1",
    "vitest": "^4.1.12"
  },
  "browserslist": [
    "defaults"
  ]
}
