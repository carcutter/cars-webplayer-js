{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // Not cached: pnpm updates demo-angular's copy of the package (injected,
      // see pnpm-workspace.yaml) only when the build script runs, which a
      // cache hit skips. If cached one day, put README.md and LICENSE back in
      // the inputs (excluded at the root): ng-packagr copies them in dist/
      "cache": false
    }
  }
}
