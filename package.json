{
  "name": "cars-webplayer",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:core",
    "dev:core": "turbo dev --filter=@car-cutter/core-ui --",
    "dev:core-preact": "pnpm dev:core --mode development-preact",
    "dev:core-wc": "turbo dev --filter=@car-cutter/core-wc --",
    "dev:showroom": "turbo dev --filter=@car-cutter/webplayer-showroom --",
    "dev:docs": "turbo dev --filter=@car-cutter/webplayer-docs --",
    "demo": "turbo dev --filter='demo-*' --concurrency 20",
    "demo:index": "turbo dev --filter=demo-index --",
    "demo:angular": "turbo dev --filter=demo-angular --",
    "demo:iframe": "turbo dev --filter=demo-iframe --",
    "demo:next": "turbo dev --filter=demo-next --",
    "demo:react": "turbo dev --filter=demo-react --",
    "demo:react-legacy": "turbo dev --filter=demo-react-legacy --",
    "demo:script": "turbo dev --filter=demo-script --",
    "demo:vanilla": "turbo dev --filter=demo-vanilla --",
    "demo:vue": "turbo dev --filter=demo-vue --",
    "demo:wc": "turbo dev --filter=demo-wc --",
    "clean": "find . \\( -type d \\( -name 'node_modules' -o -name '.turbo' -o -name 'dist' \\) -o -name '*.tsbuildinfo' \\) -prune -exec rm -rf {} +",
    "build": "turbo build --ui tui --",
    "build:core": "turbo build --filter=@car-cutter/core-ui",
    "build:angular": "turbo build --filter=@car-cutter/angular-webplayer",
    "build:next": "turbo build --filter=@car-cutter/next-webplayer",
    "build:react": "turbo build --filter=@car-cutter/react-webplayer",
    "build:script": "turbo build --filter=@car-cutter/script-webplayer",
    "build:vanilla": "turbo build --filter=@car-cutter/vanilla-webplayer",
    "build:vue": "turbo build --filter=@car-cutter/vue-webplayer",
    "build:wc": "turbo build --filter=@car-cutter/wc-webplayer",
    "lint": "turbo lint --ui tui --continue",
    "test": "turbo test --ui tui --continue",
    "e2e": "pnpm --filter e2e e2e",
    "e2e:cdn": "pnpm --filter e2e e2e:cdn",
    "test:consumers": "node scripts/consumer-test.js",
    "syncpack:lint": "syncpack lint",
    "syncpack:fix": "syncpack fix",
    "ci": "pnpm install --frozen-lockfile && syncpack lint && turbo run build lint --ui tui",
    "ci:core": "turbo run build lint --filter=@car-cutter/core-ui",
    "ci:hard": "pnpm clean && pnpm run ci",
    "version:commit": "changeset add",
    "version:apply": "changeset version",
    "publish:packages": "turbo run build lint && changeset publish",
    "publish:docs": "turbo build --filter=@car-cutter/webplayer-docs && pnpm --filter @car-cutter/webplayer-docs run deploy"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jiti": "^2.6.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "syncpack": "^15.3.3",
    "tailwindcss": "^4.3.4",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.34.7"
}
