{
  "versionGroups": [
    {
      "label": "Local packages are linked via the pnpm workspace, and published with a ^ range",
      "dependencies": ["@car-cutter/**"],
      "dependencyTypes": ["dev", "prod"],
      "pinVersion": "workspace:^"
    },
    {
      "label": "vue-webplayer builds its declarations against the lowest Vue it supports (peer ^3.3)",
      "packages": ["@car-cutter/vue-webplayer"],
      "dependencies": ["vue-3.3"],
      "isIgnored": true
    },
    {
      "label": "angular-webplayer builds with the lowest Angular it supports (peer >=19), and the TypeScript of its compiler",
      "packages": ["@car-cutter/angular-webplayer"],
      "dependencies": ["@angular/**", "ng-packagr", "typescript"],
      "dependencyTypes": ["dev"],
      "isIgnored": true
    },
    {
      "label": "demo-react-legacy runs on React 17, unlike the rest of the repo",
      "packages": ["demo-react-legacy"],
      "dependencies": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "isIgnored": true
    },
    {
      "label": "Framework peer ranges must stay wide (publishable wrappers omit them; internal pkgs keep wide ranges - never pin/unify to installed version)",
      "dependencies": ["@angular/core", "next", "react", "react-dom", "vue"],
      "dependencyTypes": ["peer"],
      "isIgnored": true
    }
  ]
}
