{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // .env* files: gitignored, so out of $TURBO_DEFAULT$, but read by Vite
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!README.md",
        "!LICENSE",
        "!dev/**"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      // Type-checks against the built declarations of the workspace packages
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
