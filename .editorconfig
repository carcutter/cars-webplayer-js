# https://editorconfig.org, also read by Prettier (indentation, end of line)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces are a line break in Markdown
[*.{md,mdx}]
trim_trailing_whitespace = false
